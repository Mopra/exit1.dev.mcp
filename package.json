{
  "name": "exit1-mcp",
  "version": "0.3.0",
  "description": "MCP server for Exit1 uptime monitoring — set up monitors, configure alerts, and query uptime from AI assistants",
  "mcpName": "dev.exit1/exit1-mcp",
  "keywords": [
    "mcp",
    "exit1",
    "uptime",
    "monitoring",
    "model-context-protocol",
    "observability",
    "alerting"
  ],
  "license": "MIT",
  "author": "Exit1",
  "homepage": "https://exit1.dev",
  "bugs": {
    "url": "https://github.com/Mopra/exit1.dev.mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mopra/exit1.dev.mcp.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "exit1-mcp": "bin/exit1-mcp.js"
  },
  "files": [
    "dist",
    "bin",
    "server.json"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node scripts/smoke-test.mjs",
    "check:catalog": "node scripts/check-catalog-sync.mjs",
    "prepublishOnly": "npm run build && node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
